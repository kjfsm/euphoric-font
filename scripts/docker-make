#!/bin/sh
# ホストに Python を入れずに、Docker の中で make を走らせる。
#   scripts/docker-make build
#   scripts/docker-make test proof
# venv/ はコンテナの Python を指すので、ホストで直接 make するとこの venv は動かない。
set -eu
cd "$(dirname "$0")/.."
docker build -q -t euphoric-font-build . >/dev/null
exec docker run --rm -u "$(id -u):$(id -g)" -v "$PWD":/work euphoric-font-build make "$@"
