// fonts.euphoric.band で dist/ を静的ファイルとして配る。Worker のコードは持たない。
// dist/ は scripts/build-site.sh が fonts/ と out/ から作る。
{
  "name": "euphoric-font",
  "account_id": "7566357725ada96d61729e5cdb699de1",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist"
  },
  // ホスト全体をこの Worker に付ける。ほかのフォントを同じホストに足すときは、そのパスに
  // ルートで別の Worker を付ければ、Custom Domain のこちらより先に動く。
  "routes": [
    {
      "pattern": "fonts.euphoric.band",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
